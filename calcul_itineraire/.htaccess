# ═══════════════════════════════════════════════════════
# .htaccess — dossier /calcul_itineraire/ sur Alwaysdata
# ═══════════════════════════════════════════════════════

# Pas de liste des fichiers du dossier
Options -Indexes

# Données et fichiers sensibles : lisibles par PHP, jamais téléchargeables directement
<FilesMatch "(^dangers_data\.json|\.example\.php|\.bak|\.log|\.md|~)$">
    Require all denied
</FilesMatch>

# En-têtes de sécurité
<IfModule mod_headers.c>
    # Le navigateur ne devine pas le type des fichiers
    Header always set X-Content-Type-Options "nosniff"
    # La page ne peut pas être intégrée dans un autre site (anti-clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"
    # L'adresse complète n'est pas transmise aux sites externes
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Toujours en HTTPS pendant un an
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
